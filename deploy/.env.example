# Zkopíruj na serveru jako deploy/.env a doplň skutečné hodnoty.
# Soubor NIKDY necommituj — je v .gitignore.

# --- Databáze ----------------------------------------------------------
# Heslo si vygeneruj, např.:  openssl rand -base64 24
POSTGRES_USER=familyfood
POSTGRES_PASSWORD=
POSTGRES_DB=family_food

# --- JWT ---------------------------------------------------------------
# Dva různé náhodné řetězce, každý aspoň 32 znaků:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Doména ------------------------------------------------------------
# Mobilní aplikace hlavičku Origin neposílá, takže na CORS nezáleží.
# Až přibude webová verze, vyplň sem její adresu místo hvězdičky.
CORS_ORIGINS=*

# --- Doména aplikace ---------------------------------------------------
MAX_PLANNING_MONTHS_AHEAD=3
INVITE_TTL_DAYS=14

# --- AI nákupní seznam -------------------------------------------------
# Klíč z console.anthropic.com. Bez něj běží všechno ostatní,
# jen generování seznamu vrací 409 AI_NOT_CONFIGURED.
ANTHROPIC_API_KEY=
