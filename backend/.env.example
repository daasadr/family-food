# Zkopíruj do .env a doplň skutečné hodnoty. .env je v .gitignore.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (lokální portable instance na D:\dev\pgsql)
DATABASE_URL="postgresql://familyfood:familyfood@localhost:5432/family_food?schema=public"

# JWT — v produkci nahraď dlouhými náhodnými řetězci (min. 32 znaků)
JWT_ACCESS_SECRET="dev-access-secret-change-me-please-32chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please-32chars"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Doména aplikace — limit plánování dopředu (sekce 3 zadání)
MAX_PLANNING_MONTHS_AHEAD=3
INVITE_TTL_DAYS=14

# CORS — čárkou oddělený seznam origins; * pro lokální vývoj
CORS_ORIGINS=*

# Fáze 2: AI nákupní seznam
ANTHROPIC_API_KEY=

# Push notifikace (Firebase Cloud Messaging)
# Bez nich API funguje dál, jen se nic neodešle.
# FCM_PROJECT_ID najdeš v Firebase konzoli → Project settings → Project ID.
FCM_PROJECT_ID=
# Celý JSON service accountu na jednom řádku, v JEDNODUCHÝCH uvozovkách:
# FCM_SERVICE_ACCOUNT='{"type":"service_account","project_id":"…", …}'
FCM_SERVICE_ACCOUNT=
# Nebo místo toho cesta k souboru (na serveru spolehlivější):
# FCM_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
